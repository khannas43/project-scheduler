# Copy to infra/.env (gitignored) before `docker compose -f infra/compose.yaml up`.
# See docs/TECHNICAL_DESIGN.md Appendix B for the full variable reference.
# This is the compose-stack env — for running apps/api directly on the host
# instead, see apps/api/.env.example (points DATABASE_URL at localhost).

POSTGRES_PASSWORD=change-me

# Must match POSTGRES_PASSWORD above and use the `postgres` service name as
# host — compose doesn't interpolate one env var inside another's value, so
# this is written out in full rather than templated.
DATABASE_URL=postgresql://scheduler:change-me@postgres:5432/scheduler

JWT_SECRET=change-me-to-a-long-random-string
CORS_ORIGIN=http://localhost:8080

# Read once, by the seed job, to create the bootstrap admin account.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me
