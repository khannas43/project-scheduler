# Copy to .env in this folder. Do not commit .env.

# Images you were given pull access to (change registry/tag as instructed).
SCHEDULER_API_IMAGE=ghcr.io/khannas43/project-scheduler-api:1.0.0
SCHEDULER_WEB_IMAGE=ghcr.io/khannas43/project-scheduler-web:1.0.0

POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://scheduler:change-me@postgres:5432/scheduler

JWT_SECRET=change-me-to-a-long-random-string
CORS_ORIGIN=http://localhost:8081
WEB_PORT=8081

# First admin on this instance (seed runs once at startup; re-run upserts the password).
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me
