# See docs/TECHNICAL_DESIGN.md Appendix B for the full set this app will
# eventually need. Only the variables actually read by code so far are here.

DATABASE_URL=postgresql://scheduler:scheduler@localhost:5432/scheduler

# Read once, by `pnpm db:seed`, to create the bootstrap admin account.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me

# Optional — defaults to 65536 (Appendix B) if unset.
ARGON2_MEMORY_KB=65536
