# See docs/TECHNICAL_DESIGN.md Appendix B for the full set this app will
# eventually need. Only the variables actually read by code so far are here.

DATABASE_URL=postgresql://scheduler:scheduler@localhost:5432/scheduler

# Required by the API at boot (signing access/refresh tokens).
JWT_SECRET=dev-only-not-secret-32-characters-min

# Read once, by `pnpm db:seed`, to create the bootstrap admin account.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me

# Optional — defaults to 65536 (Appendix B) if unset.
ARGON2_MEMORY_KB=65536

# Optional SMTP — if SMTP_HOST is empty, task/welcome emails are logged only.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=scheduler@example.com
# APP_BASE_URL=http://localhost:5173
